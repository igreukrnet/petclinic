<aspectj>
    <weaver options="-Xset:weaveJavaPackages=false,weaveJavaxPackages=false">
        <include within="org.springframework.samples.petclinic..*"/>
        <exclude within="java..*"/>
        <exclude within="javax..*"/>
        <exclude within="jdk..*"/>
        <exclude within="sun..*"/>
        <exclude within="com.intellij..*"/>
        <exclude within="org.junit..*"/>
    </weaver>
    <aspects>
        <aspect name="io.qameta.allure.aspects.StepsAspects"/>
        <aspect name="io.qameta.allure.aspects.AttachmentsAspects"/>
    </aspects>
</aspectj>
